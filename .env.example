# サーバー設定
PORT=3456

# TikTok API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://beautystudiofuku-jpg.github.io/sns-auto-post-app/callback

# Google Business Profile API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3456/auth/google/callback

# Meta (Instagram / Facebook) Graph API
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://beautystudiofuku-jpg.github.io/sns-auto-post-app/meta-callback

# トークン暗号化キー（AES-256、32文字）
ENCRYPTION_KEY=

# SQLite DBパス
DB_PATH=./db/sns_auto_post.db

# OpenRouter（任意・未使用）
OPENROUTER_API_KEY=

# Cloudflare R2 オブジェクトストレージ
# R2_ACCESS_KEY_ID と R2_SECRET_ACCESS_KEY が設定されていれば R2 へ保存
# 未設定の場合はローカルの uploads/ にフォールバック
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://b8fecc5cf998d7007ec30e8ba3b7d22b.r2.cloudflarestorage.com
R2_BUCKET=sns-auto-post-media
R2_PUBLIC_URL=https://pub-83018942c3124bfcb182011ba3ef7a72.r2.dev

# 本番デプロイ時のベースURL（任意）
# 設定するとローカルストレージ時の画像URLが置き換わる
# PUBLIC_BASE_URL=https://your-app.onrender.com
